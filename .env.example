# -----------------------------------------------------------------------------
# WatchTown Environment Configuration Example
# -----------------------------------------------------------------------------

# 1. MongoDB Database (External Database)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/watchtown?retryWrites=true&w=majority
MONGODB_DB=watchtown

# 2. AWS S3 Storage (For Watch Images)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# AWS_S3_CUSTOM_DOMAIN=cdn.watchtown.in

# 3. Security Secrets
SESSION_SECRET=
ADMIN_REGISTRATION_SECRET=
# ADMIN_DEFAULT_PASSWORD=

# 4. Email Service (Resend for Registration OTPs)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=WatchTown <onboarding@resend.dev>
